# ==============================================================================
# TruthLens AI - Environment Configuration Template (.env.example)
# Problem Statement PS03: Multi-Agent Research & Fact-Checking System
# ==============================================================================
# INSTRUCTIONS:
# 1. Copy this file to `.env`: `cp .env.example .env`
# 2. Replace the placeholder values below with your authentic API keys.
# 3. NEVER commit your actual `.env` file to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Google Gemini API Configuration (REQUIRED for Cognitive Multi-Agent Reasoning)
# Obtain a free key at: https://aistudio.google.com/app/apikey
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.1-flash-lite

# ------------------------------------------------------------------------------
# 2. Live Web Search Configuration (RECOMMENDED for Live Grounding)
# Obtain a free research search key at: https://tavily.com
# If omitted or invalid, TruthLens AI automatically falls back to DuckDuckGo (zero key required).
# ------------------------------------------------------------------------------
TAVILY_API_KEY=your_tavily_api_key_here
SEARCH_ENGINE=tavily
MAX_SEARCH_RESULTS=5

# ------------------------------------------------------------------------------
# 3. Application Runtime & Debug Settings
# ------------------------------------------------------------------------------
DEBUG_MODE=False
LOG_LEVEL=INFO
